# Sonix Environment Configuration
# Copy to .env and modify

# Database (SQLite by default, use PostgreSQL for production)
# SONIX_DATABASE_URL=sqlite+aiosqlite:///sonix.db
# SONIX_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/sonix

# Server
SONIX_HOST=0.0.0.0
SONIX_PORT=8765

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SONIX_SECRET_KEY=your-secret-key-here

# JWT
SONIX_JWT_ALGORITHM=HS256
SONIX_JWT_EXPIRY_HOURS=24

# Logging
LOG_LEVEL=INFO